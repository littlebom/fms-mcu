# ==============================================================================
# FMS Platform - Production Docker Environment Configuration
# ==============================================================================

# Database Password (used by PostgreSQL container & App)
DB_PASSWORD=replace_with_strong_random_password_2026

# NextAuth Secret (Generate with: openssl rand -base64 32)
AUTH_SECRET=replace_with_strong_32_bytes_base64_secret_key==

# Public URL of the Application
APP_URL=http://localhost:3000

# Optional: Email Service (SMTP)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=FMS System <no-reply@fms.local>

# Optional: OAuth 2.0 Providers
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=
