// VibeCore Framework Starter Kit. ตารางระดับแพลตฟอร์ม (ไม่มี tenant_id): users, permissions, auth_tokens, login_throttles
generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ScopeType {
  ALL
  CAMPUS
  ORG_UNIT
}

enum TokenPurpose {
  EMAIL_VERIFY
  PASSWORD_RESET
}

enum DegreeLevel {
  BACHELOR
  MASTER
  DOCTORAL
}

enum StudyType {
  REGULAR
  SPECIAL
  INTERNATIONAL
}

enum DocumentTarget {
  STUDENT
  STAFF
  PUBLIC
}

enum FacilityType {
  MEETING_ROOM
  LABORATORY
  AUDITORIUM
  VEHICLE
}

enum ReservationStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

model Tenant {
  id        String   @id @default(uuid()) @db.Uuid
  code      String   @unique @db.VarChar(50)
  nameTh    String   @map("name_th") @db.VarChar(255)
  nameEn    String   @map("name_en") @db.VarChar(255)
  logoUrl   String?  @map("logo_url") @db.VarChar(500)
  /// { palette?: "blue"|"coral"|"pink"|"green"|"purple" }
  settings  Json     @default("{}") @db.JsonB
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  userTenants UserTenant[]
  roles       Role[]
  auditLogs         AuditLog[]
  sampleItems       SampleItem[]
  departments       Department[]
  staffProfiles     StaffProfile[]
  articleCategories ArticleCategory[]
  articles          Article[]
  academicPrograms  AcademicProgram[]
  documentCategories DocumentCategory[]
  documentItems      DocumentItem[]
  facilities         Facility[]
  reservations       Reservation[]

  @@map("tenants")
}

model User {
  id                 String    @id @default(uuid()) @db.Uuid
  /// เก็บตัวพิมพ์เล็กเสมอ
  email              String    @unique @db.VarChar(255)
  passwordHash       String?   @map("password_hash") @db.VarChar(255)
  /// ชื่อที่แสดง
  name               String    @db.VarChar(255)
  imageUrl           String?   @map("image_url") @db.VarChar(500)
  /// credentials | google | microsoft
  provider           String    @default("credentials") @db.VarChar(20)
  providerId         String?   @map("provider_id") @db.VarChar(255)
  emailVerified      Boolean   @default(false) @map("email_verified")
  isActive           Boolean   @default(true) @map("is_active")
  mustChangePassword Boolean   @default(false) @map("must_change_password")
  /// th | en | null (= ตามเบราว์เซอร์/ค่าเริ่มต้น)
  locale             String?   @db.VarChar(5)
  lastLoginAt        DateTime? @map("last_login_at") @db.Timestamptz()
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt          DateTime  @updatedAt @map("updated_at") @db.Timestamptz()

  userTenants  UserTenant[]
  authTokens   AuthToken[]
  auditLogs    AuditLog[]     @relation("AuditActor")
  staffProfile StaffProfile?
  articles     Article[]
  reservations Reservation[]

  @@map("users")
}

model UserTenant {
  id       String   @id @default(uuid()) @db.Uuid
  userId   String   @map("user_id") @db.Uuid
  tenantId String   @map("tenant_id") @db.Uuid
  isActive Boolean  @default(true) @map("is_active")
  joinedAt DateTime @default(now()) @map("joined_at") @db.Timestamptz()

  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant    Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userRoles UserRole[]

  @@unique([userId, tenantId])
  @@index([tenantId])
  @@map("user_tenants")
}

model Role {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  /// A-Z 0-9 _ เช่น SUPER_ADMIN
  code        String   @db.VarChar(50)
  nameTh      String   @map("name_th") @db.VarChar(100)
  nameEn      String   @map("name_en") @db.VarChar(100)
  description String?  @db.VarChar(500)
  /// แก้สิทธิ์/ลบไม่ได้ · SUPER_ADMIN ได้ทุกสิทธิ์โดยไม่ต้องมีแถวใน role_permissions
  isSystem    Boolean  @default(false) @map("is_system")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  tenant          Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  rolePermissions RolePermission[]
  userRoles       UserRole[]

  @@unique([tenantId, code])
  @@map("roles")
}

/// ผู้ใช้มีได้หลายแถว (หลายบทบาท / บทบาทเดียวหลายขอบเขต) · unique ที่มี scope_id null ไม่กันซ้ำใน Postgres — service ต้องเขียนแบบลบทั้งชุดแล้วสร้างใหม่
model UserRole {
  id           String    @id @default(uuid()) @db.Uuid
  userTenantId String    @map("user_tenant_id") @db.Uuid
  roleId       String    @map("role_id") @db.Uuid
  scopeType    ScopeType @default(ALL) @map("scope_type")
  /// campus_id หรือ org_unit_id หรือขอบเขตอื่นที่กำหนดเพิ่ม — null เมื่อ scope_type = ALL
  scopeId      String?   @map("scope_id") @db.Uuid
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz()

  userTenant UserTenant @relation(fields: [userTenantId], references: [id], onDelete: Cascade)
  role       Role       @relation(fields: [roleId], references: [id], onDelete: Restrict)

  @@unique([userTenantId, roleId, scopeType, scopeId])
  @@index([roleId])
  @@map("user_roles")
}

/// seed จาก src/permissions.ts ทุกครั้ง ไม่แก้ผ่าน UI
model Permission {
  id          String  @id @default(uuid()) @db.Uuid
  code        String  @unique @db.VarChar(100)
  module      String  @db.VarChar(50)
  action      String  @db.VarChar(50)
  description String? @db.VarChar(255)

  rolePermissions RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String @map("role_id") @db.Uuid
  permissionId String @map("permission_id") @db.Uuid

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

/// โทเคนใช้ครั้งเดียว — เก็บ sha256 ของโทเคน ไม่เก็บตัวจริง
model AuthToken {
  id        String       @id @default(uuid()) @db.Uuid
  userId    String       @map("user_id") @db.Uuid
  purpose   TokenPurpose
  tokenHash String       @unique @map("token_hash") @db.VarChar(128)
  /// EMAIL_VERIFY: { newEmail }
  payload   Json?        @db.JsonB
  expiresAt DateTime     @map("expires_at") @db.Timestamptz()
  usedAt    DateTime?    @map("used_at") @db.Timestamptz()
  createdAt DateTime     @default(now()) @map("created_at") @db.Timestamptz()

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose])
  @@map("auth_tokens")
}

/// กันเดารหัสผ่าน แทน Redis · key = "email:<lower>" หรือ "ip:<addr>"
model LoginThrottle {
  key         String    @id @db.VarChar(320)
  failCount   Int       @default(0) @map("fail_count")
  lockedUntil DateTime? @map("locked_until") @db.Timestamptz()
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz()

  @@map("login_throttles")
}

model AuditLog {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  actorId   String?  @map("actor_id") @db.Uuid
  /// เช่น user.create, user.suspend, role.update
  action    String   @db.VarChar(100)
  entity    String   @db.VarChar(50)
  entityId  String   @map("entity_id") @db.VarChar(64)
  before    Json?    @db.JsonB
  after     Json?    @db.JsonB
  ip        String?  @db.VarChar(64)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  actor  User?  @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([tenantId, entity, entityId])
  @@index([tenantId, createdAt])
  @@map("audit_logs")
}

/// โมเดลตัวอย่าง (Sample CRUD) สำหรับให้นักเรียนดูเป็นแม่แบบในการพัฒนาฟีเจอร์ใหม่
model SampleItem {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  title       String   @db.VarChar(255)
  description String?  @db.Text
  status      String   @default("ACTIVE") @db.VarChar(50)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("sample_items")
}

model Department {
  id         String   @id @default(uuid()) @db.Uuid
  tenantId   String   @map("tenant_id") @db.Uuid
  code       String   @db.VarChar(50)
  nameTh     String   @map("name_th") @db.VarChar(255)
  nameEn     String   @map("name_en") @db.VarChar(255)
  isAcademic Boolean  @default(true) @map("is_academic")
  sortOrder  Int      @default(0) @map("sort_order")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  tenant           Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  staffProfiles    StaffProfile[]
  academicPrograms AcademicProgram[]

  @@unique([tenantId, code])
  @@index([tenantId])
  @@map("departments")
}

model StaffProfile {
  id            String   @id @default(uuid()) @db.Uuid
  tenantId      String   @map("tenant_id") @db.Uuid
  userId        String?  @unique @map("user_id") @db.Uuid
  departmentId  String   @map("department_id") @db.Uuid
  prefixTh      String   @map("prefix_th") @db.VarChar(50)
  prefixEn      String   @map("prefix_en") @db.VarChar(50)
  firstNameTh   String   @map("first_name_th") @db.VarChar(100)
  lastNameTh    String   @map("last_name_th") @db.VarChar(100)
  firstNameEn   String   @map("first_name_en") @db.VarChar(100)
  lastNameEn    String   @map("last_name_en") @db.VarChar(100)
  positionTh    String   @map("position_th") @db.VarChar(255)
  positionEn    String   @map("position_en") @db.VarChar(255)
  email         String   @db.VarChar(255)
  phoneExt      String?  @map("phone_ext") @db.VarChar(50)
  roomNumber    String?  @map("room_number") @db.VarChar(50)
  avatarUrl     String?  @map("avatar_url") @db.VarChar(500)
  education     Json     @default("[]") @db.JsonB
  expertises    Json     @default("[]") @db.JsonB
  academicWorks Json     @default("[]") @db.JsonB
  sortOrder     Int      @default(0) @map("sort_order")
  isActive      Boolean  @default(true) @map("is_active")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  tenant     Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user       User?      @relation(fields: [userId], references: [id], onDelete: SetNull)
  department Department @relation(fields: [departmentId], references: [id], onDelete: Restrict)

  @@index([tenantId])
  @@index([tenantId, departmentId])
  @@map("staff_profiles")
}

model ArticleCategory {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  nameTh    String   @map("name_th") @db.VarChar(255)
  nameEn    String   @map("name_en") @db.VarChar(255)
  slug      String   @db.VarChar(100)
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  articles Article[]

  @@unique([tenantId, slug])
  @@index([tenantId])
  @@map("article_categories")
}

model Article {
  id            String    @id @default(uuid()) @db.Uuid
  tenantId      String    @map("tenant_id") @db.Uuid
  categoryId    String    @map("category_id") @db.Uuid
  authorId      String    @map("author_id") @db.Uuid
  titleTh       String    @map("title_th") @db.VarChar(255)
  titleEn       String    @map("title_en") @db.VarChar(255)
  slug          String    @db.VarChar(255)
  excerptTh     String?   @map("excerpt_th") @db.Text
  excerptEn     String?   @map("excerpt_en") @db.Text
  contentTh     String    @map("content_th") @db.Text
  contentEn     String    @map("content_en") @db.Text
  coverImageUrl String?   @map("cover_image_url") @db.VarChar(500)
  attachments   Json      @default("[]") @db.JsonB
  isPinned      Boolean   @default(false) @map("is_pinned")
  isFeatured    Boolean   @default(false) @map("is_featured")
  status        String    @default("DRAFT") @db.VarChar(50)
  publishedAt   DateTime? @map("published_at") @db.Timestamptz()
  viewCount     Int       @default(0) @map("view_count")
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz()

  tenant   Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  category ArticleCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  author   User            @relation(fields: [authorId], references: [id], onDelete: Restrict)

  @@unique([tenantId, slug])
  @@index([tenantId])
  @@index([tenantId, categoryId])
  @@index([tenantId, status])
  @@map("articles")
}

model AcademicProgram {
  id               String      @id @default(uuid()) @db.Uuid
  tenantId         String      @map("tenant_id") @db.Uuid
  departmentId     String      @map("department_id") @db.Uuid
  code             String      @db.VarChar(50)
  degreeLevel      DegreeLevel @default(BACHELOR) @map("degree_level")
  studyType        StudyType   @default(REGULAR) @map("study_type")
  nameTh           String      @map("name_th") @db.VarChar(255)
  nameEn           String      @map("name_en") @db.VarChar(255)
  degreeNameTh     String      @map("degree_name_th") @db.VarChar(255)
  degreeNameEn     String      @map("degree_name_en") @db.VarChar(255)
  totalCredits     Int         @default(120) @map("total_credits")
  tuitionFee       String?     @map("tuition_fee") @db.VarChar(255)
  durationYears    Decimal     @default(4.0) @map("duration_years") @db.Decimal(3, 1)
  descriptionTh    String?     @map("description_th") @db.Text
  descriptionEn    String?     @map("description_en") @db.Text
  philosophyTh     String?     @map("philosophy_th") @db.Text
  philosophyEn     String?     @map("philosophy_en") @db.Text
  careerPaths      Json        @default("[]") @map("career_paths") @db.JsonB
  coverImageUrl    String?     @map("cover_image_url") @db.VarChar(500)
  brochureUrl      String?     @map("brochure_url") @db.VarChar(500)
  curriculumPdfUrl String?     @map("curriculum_pdf_url") @db.VarChar(500)
  applicationUrl   String?     @map("application_url") @db.VarChar(500)
  isOpenAdmissions Boolean     @default(true) @map("is_open_admissions")
  isActive         Boolean     @default(true) @map("is_active")
  sortOrder        Int         @default(0) @map("sort_order")
  createdAt        DateTime    @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt        DateTime    @updatedAt @map("updated_at") @db.Timestamptz()

  tenant     Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  department Department @relation(fields: [departmentId], references: [id], onDelete: Restrict)

  @@unique([tenantId, code])
  @@index([tenantId])
  @@index([tenantId, departmentId])
  @@index([tenantId, degreeLevel])
  @@map("academic_programs")
}

model DocumentCategory {
  id        String         @id @default(uuid()) @db.Uuid
  tenantId  String         @map("tenant_id") @db.Uuid
  code      String         @db.VarChar(50)
  nameTh    String         @map("name_th") @db.VarChar(255)
  nameEn    String         @map("name_en") @db.VarChar(255)
  target    DocumentTarget @default(PUBLIC)
  sortOrder Int            @default(0) @map("sort_order")
  createdAt DateTime       @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt DateTime       @updatedAt @map("updated_at") @db.Timestamptz()

  tenant    Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  documents DocumentItem[]

  @@unique([tenantId, code])
  @@index([tenantId])
  @@map("document_categories")
}

model DocumentItem {
  id            String           @id @default(uuid()) @db.Uuid
  tenantId      String           @map("tenant_id") @db.Uuid
  categoryId    String           @map("category_id") @db.Uuid
  code          String?          @db.VarChar(50)
  titleTh       String           @map("title_th") @db.VarChar(255)
  titleEn       String           @map("title_en") @db.VarChar(255)
  descriptionTh String?          @map("description_th") @db.Text
  descriptionEn String?          @map("description_en") @db.Text
  fileUrl       String           @map("file_url") @db.VarChar(500)
  fileType      String           @default("pdf") @map("file_type") @db.VarChar(20)
  fileSizeBytes Int?             @map("file_size_bytes")
  downloadCount Int              @default(0) @map("download_count")
  isActive      Boolean          @default(true) @map("is_active")
  sortOrder     Int              @default(0) @map("sort_order")
  createdAt     DateTime         @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt     DateTime         @updatedAt @map("updated_at") @db.Timestamptz()

  tenant   Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  category DocumentCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  @@index([tenantId])
  @@index([tenantId, categoryId])
  @@map("document_items")
}

model Facility {
  id        String       @id @default(uuid()) @db.Uuid
  tenantId  String       @map("tenant_id") @db.Uuid
  code      String       @db.VarChar(50)
  type      FacilityType @default(MEETING_ROOM)
  nameTh    String       @map("name_th") @db.VarChar(255)
  nameEn    String       @map("name_en") @db.VarChar(255)
  location  String?      @db.VarChar(255)
  capacity  Int          @default(10)
  equipment Json         @default("[]") @db.JsonB
  imageUrl  String?      @map("image_url") @db.VarChar(500)
  isActive  Boolean      @default(true) @map("is_active")
  sortOrder Int          @default(0) @map("sort_order")
  createdAt DateTime     @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt DateTime     @updatedAt @map("updated_at") @db.Timestamptz()

  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  reservations Reservation[]

  @@unique([tenantId, code])
  @@index([tenantId])
  @@index([tenantId, type])
  @@map("facilities")
}

model Reservation {
  id              String            @id @default(uuid()) @db.Uuid
  tenantId        String            @map("tenant_id") @db.Uuid
  facilityId      String            @map("facility_id") @db.Uuid
  userId          String?           @map("user_id") @db.Uuid
  reservedByName  String            @map("reserved_by_name") @db.VarChar(255)
  reservedByEmail String            @map("reserved_by_email") @db.VarChar(255)
  reservedByPhone String            @map("reserved_by_phone") @db.VarChar(50)
  reservedByDept  String?           @map("reserved_by_dept") @db.VarChar(255)
  title           String            @db.VarChar(255)
  description     String?           @db.Text
  attendeeCount   Int               @default(1) @map("attendee_count")
  startTime       DateTime          @map("start_time") @db.Timestamptz()
  endTime         DateTime          @map("end_time") @db.Timestamptz()
  status          ReservationStatus @default(PENDING)
  reviewNote      String?           @map("review_note") @db.Text
  reviewedAt      DateTime?         @map("reviewed_at") @db.Timestamptz()
  reviewedById    String?           @map("reviewed_by_id") @db.Uuid
  createdAt       DateTime          @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt       DateTime          @updatedAt @map("updated_at") @db.Timestamptz()

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  facility Facility @relation(fields: [facilityId], references: [id], onDelete: Restrict)
  user     User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([tenantId, facilityId])
  @@index([tenantId, startTime, endTime])
  @@map("reservations")
}


